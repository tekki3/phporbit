# Copy to .env and edit. The .env file is git-ignored; this example is not.
#
# Values injected by the real environment (Docker, systemd, Kubernetes) always
# win over anything set here, so a stale .env on a server cannot override the
# platform's configuration.

# Exposes exception details in responses and recompiles templates on every
# render. Must be false anywhere the public can reach.
APP_DEBUG=false

# Absolute base URL, used to build link-preview image URLs. Scrapers do not
# resolve relative paths, so this must include the scheme and host.
APP_URL=http://localhost:8080

# 32 random bytes, base64-encoded. Generate with `orbit key:generate`.
# Required: encryption and signing refuse to start without it, and a blank
# value is exactly as unusable as an absent one.
APP_KEY=base64:7p9TvLAdiTR6UfO66v5CsSEdRnpAo2DNWvjiM0ghLZc=

# Keys retired by a rotation. Comma-separated, still able to read data written
# before the change, never used to write new.
#APP_PREVIOUS_KEYS=

# debug | info | warning | error
LOG_LEVEL=info

# sqlite | mysql | pgsql | sqlsrv (also accepts postgres, postgresql, mariadb,
# sqlserver, sql_server and mssql)
DB_DRIVER=sqlite

# sqlite: a file path. Relative paths are resolved against the project root, so
# this works the same from the CLI, a web server and cron. ":memory:" is also
# accepted. For mysql, pgsql and sqlsrv this is the database name instead, and
# is required — there is no sensible default.
DB_DATABASE=storage/app.sqlite

# Ignored by sqlite. DB_PORT defaults to 3306 for mysql, 5432 for pgsql and
# 1433 for SQL Server.
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USERNAME=orbit
#DB_PASSWORD=
# DB_CHARSET applies to mysql and pgsql. PDO_SQLSRV uses UTF-8 by default.
#DB_CHARSET=utf8mb4
# mysql only: connect over a unix socket instead of TCP. Takes precedence
# over DB_HOST when set.
#DB_SOCKET=/var/run/mysqld/mysqld.sock

# Application data cache: file (or storage) | redis | memcached.
# File storage needs no extension or server. TTL is seconds; 0 never expires.
CACHE_DRIVER=file
CACHE_TTL=300
# Relative to the project root; separate from compiled templates.
#CACHE_PATH=storage/cache/data
# Defaults to a hash of the project root. Set the same unique prefix on all
# instances of one deployed application when sharing a remote cache.
#CACHE_PREFIX=my-app
# Redis defaults to 6379; Memcached to 11211. Both require their PHP extension.
#CACHE_HOST=127.0.0.1
#CACHE_PORT=6379
#CACHE_TIMEOUT=2
# Redis only (ACL username optional).
#CACHE_DATABASE=0
#CACHE_USERNAME=
#CACHE_PASSWORD=

# array | smtp
# "array" keeps messages in memory instead of sending them — the right default
# in development, and what tests use.
MAIL_DRIVER=array

# true stores messages as pending in mail_log instead of sending them directly.
# Deliver them later with `orbit mail:send-pending`.
MAIL_QUEUE=false

#MAIL_HOST=smtp.example.test
# tls (STARTTLS, port 587) | ssl (implicit TLS, port 465) | none
#MAIL_ENCRYPTION=tls
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM_ADDRESS=no-reply@example.test
#MAIL_FROM_NAME=phporbit
#MAIL_TIMEOUT=10
# Sending credentials over an unencrypted connection is refused unless this is
# set: SMTP AUTH base64-encodes the password, which is not encryption.
#MAIL_ALLOW_INSECURE_AUTH=false

# Session cookie and server-side lifetime, in seconds.
SESSION_LIFETIME=7200
SESSION_COOKIE=orbit_session

# Largest avatar accepted, in bytes.
UPLOAD_MAX_BYTES=1048576

# Failed logins tolerated per email+address pair within the window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Optional external login. Link external accounts from /account/security first.
# Register the exact APP_URL + /auth/google/callback or /auth/entra/callback
# as a Web redirect URI with the provider. HTTPS required outside loopback.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=
# Explicit comma-separated tenant UUIDs; common/organizations are not tenants.
#ENTRA_TENANT_IDS=
# Password-reset and magic-link emails require MAIL_DRIVER=smtp. They send
# directly, ignoring MAIL_QUEUE, and are not copied into the readable mail log.

# Comma-separated addresses whose X-Forwarded-Proto and X-Forwarded-For are
# believed. Leave empty unless this app genuinely sits behind a proxy you
# control: trusting these headers from anyone lets a client claim any scheme
# or address it likes.
TRUSTED_PROXIES=

# Quoting, for reference:
#   PLAIN=no quotes needed        # trailing comments need a space before #
#   QUOTED="escapes \n and ${DB_DATABASE} expansion"
#   LITERAL='no escapes, no expansion, $ and \ are ordinary'
