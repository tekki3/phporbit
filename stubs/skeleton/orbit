#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The phporbit CLI for this project.
 *
 * `./orbit serve` runs the framework's own HTTP server — a long-lived process,
 * matching the model FrankenPHP uses, so worker-safety problems surface here
 * rather than in production.
 */

use PhpOrbit\Admin\AdminApplication;
use PhpOrbit\Cache\CacheFactory;
use PhpOrbit\Cache\CacheFailed;
use PhpOrbit\Config\Environment;
use PhpOrbit\Config\InvalidEnvFile;
use PhpOrbit\Config\MissingConfiguration;
use PhpOrbit\Console\ClassMaker;
use PhpOrbit\Console\AuthMaker;
use PhpOrbit\Console\AuthAdmin;
use PhpOrbit\Console\ApiMaker;
use PhpOrbit\Console\ControllerMaker;
use PhpOrbit\Console\FormMaker;
use PhpOrbit\Console\Lifetime;
use PhpOrbit\Console\MiddlewareMaker;
use PhpOrbit\Console\MigrationMaker;
use PhpOrbit\Console\ModelMaker;
use PhpOrbit\Console\SeedMaker;
use PhpOrbit\Crypto\Key;
use PhpOrbit\Database\Connection;
use PhpOrbit\Database\ConnectionFailed;
use PhpOrbit\Database\Migrator;
use PhpOrbit\Database\SeedFailed;
use PhpOrbit\Database\SeedRunner;
use PhpOrbit\Kernel\Application;
use PhpOrbit\Mail\MailFailed;
use PhpOrbit\Mail\MailStatus;
use PhpOrbit\Mail\Message;
use PhpOrbit\Mail\PersistingMailer;
use PhpOrbit\Routing\Exception\InvalidRoutePattern;
use PhpOrbit\Sapi\OrbitServer;
use PhpOrbit\Session\FileSessionStore;

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, 'orbit must be run from the command line.' . PHP_EOL);
    exit(1);
}

$root = __DIR__;

if (!is_file($root . '/vendor/autoload.php')) {
    fwrite(STDERR, 'Dependencies are not installed. Run: composer install' . PHP_EOL);
    exit(1);
}

require $root . '/vendor/autoload.php';

/**
 * @param array<mixed> $argv
 * @return array<string, string>
 */
$parseOptions = static function (array $argv): array {
    $options = [];

    foreach ($argv as $argument) {
        if (!is_string($argument) || !str_starts_with($argument, '--')) {
            continue;
        }

        $pair = substr($argument, 2);
        $separator = strpos($pair, '=');

        if ($separator === false) {
            $options[$pair] = '1';
            continue;
        }

        $options[substr($pair, 0, $separator)] = substr($pair, $separator + 1);
    }

    return $options;
};

$usage = <<<TXT
Commands:
  orbit make:auth
      Generate login, verified registration, MFA, profiles and administrator
      user management. Never overwrites existing files.
  orbit make:api <Name> [--method=GET] [--version=1] [--public]
      Generate a JSON endpoint, automatically register its versioned route
      and include it in Swagger. Bearer authentication is required unless --public.
  orbit auth:admin <email>
      Grant administrator access to an existing verified, active scaffolded account.
  orbit key:generate
      Generate and print a new application key; it does not change any files.
  orbit make:class <Name> [--singleton|--scoped] [--force]
      Generate an App\ class. Autowired is the default lifetime; the flags
      register it as a singleton or request-scoped service.
  orbit make:controller <Name> [--view] [--force]
      Generate a controller and print its route registration; --view also
      creates a matching template.
  orbit make:form <Name> [--fields=a:text,b:email] [--captcha]
                         [--no-honeypot] [--controllers] [--force]
      Generate a form with honeypot protection by default. Choose fields,
      optionally add a captcha or generate its controllers and template.
  orbit make:middleware <Name> [--force]
      Generate middleware and print its registration; add it to the
      middleware list yourself to choose its position.
  orbit make:migration <name> [--table=x] [--sequential] [--force]
      Generate a migration. Filenames use timestamps by default; --sequential
      uses a numbered prefix, and --table sets the target table.
  orbit make:seed <name> [--force]
      Generate a database seeder.
  orbit make:model <Name> [--table=x] [--fields=a:string,b:int] [--force]
      Generate a typed model and its row mappings; --table overrides the
      inferred table name.
  orbit serve [--host=127.0.0.1] [--port=8080] [--debug]
      Apply pending migrations and start the development server. --debug
      enables detailed errors and template recompilation.
  orbit ui [--host=127.0.0.1] [--port=8081] [--debug]
      Start the local admin dashboard for migrations, mail, routes, seeders,
      sessions, storage and generators. It has no login.
  orbit routes
      Print the application's compiled route table.
  orbit migrate
      Apply all pending database migrations.
  orbit migrate:status
      Show available migrations and whether each has been applied.
  orbit migrate:rollback [--batches=1]
      Roll back the most recent batch, or the requested number of batches.
  orbit db:seed [name]
      Run all database seeders, or only the named seeder.
  orbit mail:test --to=x@example.test [--from=x@example.test]
      Send a test message (or queue it when MAIL_QUEUE=true). Uses the
      configured sender unless --from is provided.
  orbit mail:list [--status=sent|failed|pending] [--limit=20]
      List logged mail, optionally filtered by status and limited in count.
  orbit mail:send-pending [--limit=50]
      Deliver queued messages up to the requested limit.
  orbit mail:resend <id>|--failed [--limit=50]
      Retry one failed message by id, or retry failed messages up to the limit.
  orbit cache:clear
      Clear application data in the configured cache backend and namespace.
  orbit storage:clear
      Remove compiled templates; they are rebuilt automatically when needed.
  orbit sessions:gc
      Delete expired session files.
  orbit help
      Show this command list.

TXT;

// $_SERVER rather than the $argv global, which exists only when
// register_argc_argv is on. This script is a SAPI boundary.
$rawArguments = $_SERVER['argv'] ?? [];
$arguments = is_array($rawArguments) ? array_slice($rawArguments, 1) : [];
$command = is_string($arguments[0] ?? null) ? $arguments[0] : 'help';
$options = $parseOptions($arguments);

if (isset($options['debug'])) {
    putenv('APP_DEBUG=true');
}

$bootstrap = $root . '/app/bootstrap.php';

try {
    switch ($command) {
    case 'key:generate':
        // Writes nothing: printing it keeps the command safe to run anywhere,
        // and makes it obvious that the value belongs in configuration the
        // deployment supplies rather than in a file someone might commit.
        echo Key::generate()->exportForConfiguration() . PHP_EOL;
        exit(0);

    case 'make:auth':
        try {
            if ($options !== [] || count($arguments) !== 1) {
                throw new InvalidArgumentException('Usage: orbit make:auth (no options; existing files are never overwritten).');
            }
            $files = (new AuthMaker($root))->create();
            printf("Generated authentication: %d files.\n\n", count($files));
            echo "New blank projects load app/auth.php automatically.\n";
            echo "For older projects, add inside the boot callback, after service bindings:\n  " . AuthMaker::WIRING . "\n\n";
            echo "Next: configure APP_URL and SMTP, run orbit migrate, then visit /register.\n";
            echo "After verifying your account: orbit auth:admin your@email.example\n";
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }
        exit(0);

    case 'make:api':
        try {
            $positional = array_values(array_filter(array_slice($arguments, 1),
                static fn ($value): bool => is_string($value) && !str_starts_with($value, '--')));
            if (count($positional) !== 1
                || array_diff(array_keys($options), ['method', 'version', 'public']) !== []
                || (isset($options['public']) && $options['public'] !== '1')) {
                throw new InvalidArgumentException('Usage: orbit make:api <Name> [--method=GET] [--version=1] [--public]');
            }
            $method = \PhpOrbit\Http\Method::tryFrom(strtoupper($options['method'] ?? 'GET'));
            $version = filter_var($options['version'] ?? '1', FILTER_VALIDATE_INT);
            if ($method === null || $version === false) {
                throw new InvalidArgumentException('Use a valid HTTP method and an integer API version.');
            }
            $made = (new ApiMaker($root))->create($positional[0], $method, $version, isset($options['public']));
            printf("Created %s\nCreated %s\n\n%s %s — automatically registered.\n",
                $made->controllerPath, $made->declarationPath, $method->value, $made->url);
            echo "Edit the controller to return your data; edit the declaration for its OpenAPI schema.\n";
            if (!isset($options['public'])) {
                echo "Bearer-protected: in a blank project, run orbit make:auth once to provide token authentication.\n";
            }
            echo "Next: orbit migrate, restart the server, then open /api/docs.\n";
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }
        exit(0);

    case 'auth:admin':
        try {
            if (count($arguments) !== 2 || !is_string($arguments[1]) || $options !== []) {
                throw new InvalidArgumentException('Usage: orbit auth:admin <verified-email>');
            }
            $env = Environment::load($root . '/.env');
            $database = Connection::connect(\PhpOrbit\Database\DatabaseSettings::fromEnvironment($env, $root));
            (new AuthAdmin($database))->promote($arguments[1]);
            echo "Administrator access granted. Sign in again to refresh your session.\n";
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }
        exit(0);

    case 'make:class':
        // Generates source; there is no reason to boot the application first.
        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        if ($name === null) {
            fwrite(STDERR, 'Which class? Try: orbit make:class Notes/NoteRepository' . PHP_EOL);
            exit(1);
        }

        try {
            $made = (new ClassMaker($root, static function (string $line): void {
                echo $line . PHP_EOL;
            }))->create(
                $name,
                // Mutually exclusive, and refused as a pair inside the enum, so
                // every copy of this script treats the flags the same way.
                Lifetime::fromFlags(
                    singleton: isset($options['singleton']),
                    scoped: isset($options['scoped']),
                ),
                force: isset($options['force']),
            );
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        printf("\n%s — %s\n", $made->className, $made->lifetime->describe());

        // Printed rather than written, for the reason make:controller prints its
        // route line: editing a file you own means parsing and re-emitting your
        // code, and getting that subtly wrong is worse than pasting a line.
        if ($made->registrationSnippet !== null) {
            echo PHP_EOL . 'Add to app/bootstrap.php:' . PHP_EOL . PHP_EOL;
            echo '  ' . $made->importSnippet . PHP_EOL;
            echo '  ' . $made->registrationSnippet . PHP_EOL;
        }

        echo PHP_EOL . 'Inject it where you need it:' . PHP_EOL . PHP_EOL;
        echo '  ' . $made->importSnippet . PHP_EOL;
        echo '  ' . $made->injectionSnippet . PHP_EOL;
        exit(0);

    case 'make:controller':
        // Generates source; there is no reason to boot the application first.
        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        if ($name === null) {
            fwrite(STDERR, 'Which controller? Try: orbit make:controller Home' . PHP_EOL);
            exit(1);
        }

        try {
            $made = (new ControllerMaker($root, static function (string $line): void {
                echo $line . PHP_EOL;
            }))->create($name, withView: isset($options['view']), force: isset($options['force']));
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        // Routes are not edited automatically: rewriting a file you own means
        // parsing and re-emitting your code, and getting that subtly wrong is
        // worse than leaving one line to paste.
        echo PHP_EOL . 'Add to app/routes.php:' . PHP_EOL . PHP_EOL;
        echo '  ' . $made->importSnippet . PHP_EOL;
        echo '  ' . $made->routeSnippet . PHP_EOL;
        exit(0);

    case 'make:form':
        // Generates source; there is no reason to boot the application first.
        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        if ($name === null) {
            fwrite(STDERR, 'Which form? Try: orbit make:form Contact --controllers' . PHP_EOL);
            exit(1);
        }

        try {
            $made = (new FormMaker($root, static function (string $line): void {
                echo $line . PHP_EOL;
            }))->create(
                $name,
                fields: $options['fields'] ?? null,
                captcha: isset($options['captcha']),
                // On unless turned off. A protection that has to be added after
                // the fact is one that gets added after the first spam run.
                honeypot: !isset($options['no-honeypot']),
                withControllers: isset($options['controllers']),
                force: isset($options['force']),
            );
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        printf(
            "\n%s — %d fields: %s\n",
            $made->className,
            count($made->fieldNames),
            implode(', ', $made->fieldNames),
        );

        if ($made->routeSnippets !== []) {
            echo PHP_EOL . 'Add to app/routes.php:' . PHP_EOL . PHP_EOL;

            foreach ([...$made->importSnippets, ...$made->routeSnippets] as $line) {
                echo '  ' . $line . PHP_EOL;
            }
        } else {
            echo PHP_EOL . 'Build it from a controller:' . PHP_EOL . PHP_EOL;
            echo '  ' . sprintf('use %s;', $made->className) . PHP_EOL;
            echo '  ' . $made->injectionSnippet . PHP_EOL;
            echo PHP_EOL . 'Or pass --controllers to have the two pages written too.' . PHP_EOL;
        }

        exit(0);

    case 'make:middleware':
        // Generates source; there is no reason to boot the application first.
        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        if ($name === null) {
            fwrite(STDERR, 'Which middleware? Try: orbit make:middleware RequestId' . PHP_EOL);
            exit(1);
        }

        try {
            $made = (new MiddlewareMaker($root, static function (string $line): void {
                echo $line . PHP_EOL;
            }))->create($name, force: isset($options['force']));
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        // Not inserted automatically: where in the list it goes is meaning,
        // not plumbing — session before CSRF, logging outermost — and that is
        // a decision only the developer can make.
        printf("\n%s\n", $made->className);
        echo PHP_EOL . 'Add to the $app->middleware(...) list in app/bootstrap.php:' . PHP_EOL . PHP_EOL;
        echo '  ' . $made->importSnippet . PHP_EOL;
        echo '  ' . $made->registrationSnippet . PHP_EOL;
        exit(0);

    case 'make:migration':
        // Generates source; there is no reason to boot the application first.
        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        if ($name === null) {
            fwrite(STDERR, 'Which migration? Try: orbit make:migration create_articles_table' . PHP_EOL);
            exit(1);
        }

        try {
            $migration = (new MigrationMaker($root, static function (string $line): void {
                echo $line . PHP_EOL;
            }))->create(
                $name,
                table: $options['table'] ?? null,
                sequential: isset($options['sequential']),
                force: isset($options['force']),
            );
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        echo PHP_EOL . 'Edit it, then run: orbit migrate' . PHP_EOL;
        exit(0);

    case 'make:seed':
        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        if ($name === null) {
            fwrite(STDERR, 'Which seed? Try: orbit make:seed 0002_categories' . PHP_EOL);
            exit(1);
        }

        try {
            $path = (new SeedMaker($root))->create($name, force: isset($options['force']));
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        echo 'Created ' . $path . PHP_EOL;
        echo PHP_EOL . 'Edit it, then run: orbit db:seed' . PHP_EOL;
        exit(0);

    case 'make:model':
        // Generates source; there is no reason to boot the application first.
        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        if ($name === null) {
            fwrite(STDERR, 'Which model? Try: orbit make:model Note --fields=title:string,body:string' . PHP_EOL);
            exit(1);
        }

        try {
            $made = (new ModelMaker($root, static function (string $line): void {
                echo $line . PHP_EOL;
            }))->create(
                $name,
                table: $options['table'] ?? null,
                fields: $options['fields'] ?? null,
                force: isset($options['force']),
            );
        } catch (InvalidArgumentException | RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        printf(
            "\n%s — table \"%s\", %d field%s\n",
            $made->className,
            $made->table,
            count($made->fieldNames),
            count($made->fieldNames) === 1 ? '' : 's',
        );

        // Not called automatically: Model::useConnection() is boot-time
        // wiring, and this script does not edit app/bootstrap.php for the
        // same reason make:controller does not edit app/routes.php.
        echo PHP_EOL . 'Once, in app/bootstrap.php, right after $database is built:' . PHP_EOL . PHP_EOL;
        echo '  use PhpOrbit\Database\Model;' . PHP_EOL;
        echo '  Model::useConnection($database);' . PHP_EOL;
        echo PHP_EOL . 'Then use it directly — no injection, no registration:' . PHP_EOL . PHP_EOL;
        echo '  ' . $made->importSnippet . PHP_EOL;
        echo '  ' . $made->className . '::find($id);' . PHP_EOL;
        exit(0);

    case 'serve':
        /** @var Application $app */
        $app = require $bootstrap;

        // A development convenience of this command only: the production
        // entrypoints never touch the schema, because several workers booting
        // at once would race to alter the same tables.
        $migrator = $app->container()->get(Migrator::class);

        if ($migrator->pending() !== []) {
            fwrite(STDERR, 'Applying pending migrations...' . PHP_EOL);

            foreach ($migrator->migrate() as $name) {
                fwrite(STDERR, '  ' . $name . PHP_EOL);
            }
        }

        (new OrbitServer(
            host: $options['host'] ?? '127.0.0.1',
            port: (int) ($options['port'] ?? '8080'),
        ))->run($app);
        exit(0);

    case 'ui':
        // A second, self-contained application — never the one loaded from
        // app/bootstrap.php. Its routes are never wired into app/routes.php
        // either, so nothing here reaches a production deployment unless
        // this command was actually run there, which is precisely the thing
        // to avoid: see the warning below.
        $host = $options['host'] ?? '127.0.0.1';

        if (!in_array($host, ['127.0.0.1', 'localhost', '::1'], true)) {
            fwrite(STDERR, sprintf(
                'Warning: binding the admin UI to "%s" exposes it beyond this machine. '
                . 'It has no login — anyone who can reach it can run migrations, resend '
                . 'mail and clear the template cache.' . PHP_EOL,
                $host,
            ));
        }

        $admin = AdminApplication::boot($root);

        fwrite(STDERR, 'Starting the admin UI — migrations, mail, routes, seeders, sessions, storage and generators.' . PHP_EOL);

        $server = new OrbitServer(
            host: $host,
            port: (int) ($options['port'] ?? '8081'),
        );

        $server->run($admin);
        exit(0);

    case 'migrate':
        /** @var Application $app */
        $app = require $bootstrap;

        $applied = $app->container()->get(Migrator::class)->migrate();

        foreach ($applied as $name) {
            echo 'Applied ' . $name . PHP_EOL;
        }

        if ($applied === []) {
            echo 'Nothing to migrate.' . PHP_EOL;
        }

        exit(0);

    case 'migrate:status':
        /** @var Application $app */
        $app = require $bootstrap;

        $migrator = $app->container()->get(Migrator::class);
        $batches = $migrator->batches();

        foreach ($migrator->available() as $name) {
            printf(
                "%-10s %-40s %s\n",
                isset($batches[$name]) ? 'applied' : 'pending',
                $name,
                isset($batches[$name]) ? 'batch ' . $batches[$name] : '',
            );
        }

        exit(0);

    case 'migrate:rollback':
        /** @var Application $app */
        $app = require $bootstrap;

        $reversed = $app->container()->get(Migrator::class)
            ->rollback((int) ($options['batches'] ?? '1'));

        foreach ($reversed as $name) {
            echo 'Reversed ' . $name . PHP_EOL;
        }

        if ($reversed === []) {
            echo 'Nothing to roll back.' . PHP_EOL;
        }

        exit(0);

    case 'db:seed':
        /** @var Application $app */
        $app = require $bootstrap;

        $name = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $name = $argument;
                break;
            }
        }

        $seeded = (new SeedRunner(
            $app->container()->get(Connection::class),
            $root . '/database/seeders',
        ))->run($name);

        foreach ($seeded as $name) {
            echo 'Seeded ' . $name . PHP_EOL;
        }

        if ($seeded === []) {
            echo 'Nothing to seed.' . PHP_EOL;
        }

        exit(0);

    case 'mail:test':
        /** @var Application $app */
        $app = require $bootstrap;

        $to = $options['to'] ?? null;

        if ($to === null) {
            fwrite(STDERR, 'Which address? Try: orbit mail:test --to=you@example.test' . PHP_EOL);
            exit(1);
        }

        $env = $app->container()->get(Environment::class);
        $driver = $env->string('MAIL_DRIVER', 'array');
        $queue = $env->bool('MAIL_QUEUE', false);
        // Read directly rather than relying on the mailer's own default: only
        // SmtpMailer applies one, and this command has to work the same way
        // under every driver.
        $from = $options['from'] ?? $env->raw('MAIL_FROM_ADDRESS');

        if ($from === null || $from === '') {
            fwrite(STDERR,
                'No sender configured. Pass --from=you@example.test, or set '
                . 'MAIL_FROM_ADDRESS in .env.' . PHP_EOL);
            exit(1);
        }

        try {
            $message = Message::to($to)
                ->from($from)
                ->subject('phporbit test message')
                ->text($queue
                    ? sprintf(
                        "Queued by `orbit mail:test` at %s, through the %s driver.\n\n"
                        . "Run `orbit mail:send-pending` to deliver this message.",
                        gmdate('c'),
                        $driver,
                    )
                    : sprintf(
                        "Sent by `orbit mail:test` at %s, through the %s driver.\n\n"
                        . "If this arrived, MAIL_DRIVER=%s is delivering mail correctly.",
                        gmdate('c'),
                        $driver,
                        $driver,
                    ));
        } catch (InvalidArgumentException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        try {
            // Through PersistingMailer like any other send, so a test message
            // is one more row in `orbit mail:list` — and, if it fails,
            // resendable with `orbit mail:resend` once the problem is fixed.
            $app->container()->get(PersistingMailer::class)->send($message);
        } catch (MailFailed $e) {
            fwrite(STDERR, sprintf('Send failed (driver: %s): %s', $driver, $e->getMessage()) . PHP_EOL);
            exit(1);
        }

        if ($queue) {
            printf("Queued for delivery to %s.\n", $to);
        } elseif (in_array($driver, ['array', 'memory', 'null'], true)) {
            printf(
                "Accepted by the \"%s\" driver — nothing left this machine. "
                . "Set MAIL_DRIVER=smtp to test real delivery.\n",
                $driver,
            );
        } else {
            printf("Sent to %s via %s.\n", $to, $driver);
        }

        exit(0);

    case 'mail:list':
        /** @var Application $app */
        $app = require $bootstrap;

        $status = null;

        if (isset($options['status'])) {
            $status = MailStatus::tryFrom($options['status']);

            if ($status === null) {
                fwrite(STDERR, sprintf(
                    'Unknown status "%s". Use sent, failed or pending.',
                    $options['status'],
                ) . PHP_EOL);
                exit(1);
            }
        }

        $entries = $app->container()->get(PersistingMailer::class)
            ->history($status, (int) ($options['limit'] ?? '20'));

        if ($entries === []) {
            echo 'No mail logged.' . PHP_EOL;
            exit(0);
        }

        foreach ($entries as $entry) {
            printf(
                "%-5d %-7s %-4d %-34s %-40s %s\n",
                $entry->id,
                $entry->status->value,
                $entry->attempts,
                implode(', ', array_map(static fn ($address): string => $address->envelope(), $entry->to)),
                mb_strimwidth($entry->subjectLine, 0, 40, '…'),
                $entry->updatedAt,
            );
        }

        exit(0);

    case 'mail:send-pending':
        /** @var Application $app */
        $app = require $bootstrap;

        $mailer = $app->container()->get(PersistingMailer::class);
        $pending = $mailer->history(MailStatus::Pending, (int) ($options['limit'] ?? '50'));

        if ($pending === []) {
            echo 'Nothing pending to send.' . PHP_EOL;
            exit(0);
        }

        $sent = 0;
        $failed = 0;

        foreach ($pending as $entry) {
            try {
                $mailer->deliverPending($entry->id);
                printf("Sent #%d\n", $entry->id);
                $sent++;
            } catch (MailFailed $e) {
                fwrite(STDERR, sprintf('Failed #%d: %s', $entry->id, $e->getMessage()) . PHP_EOL);
                $failed++;
            }
        }

        printf("%d sent, %d failed.\n", $sent, $failed);
        exit($failed > 0 ? 1 : 0);

    case 'mail:resend':
        /** @var Application $app */
        $app = require $bootstrap;

        $mailer = $app->container()->get(PersistingMailer::class);

        if (isset($options['failed'])) {
            $failing = $mailer->history(MailStatus::Failed, (int) ($options['limit'] ?? '50'));

            if ($failing === []) {
                echo 'Nothing to resend.' . PHP_EOL;
                exit(0);
            }

            $resent = 0;
            $stillFailing = 0;

            foreach ($failing as $entry) {
                try {
                    $mailer->resend($entry->id);
                    printf("Resent #%d\n", $entry->id);
                    $resent++;
                } catch (MailFailed $e) {
                    fwrite(STDERR, sprintf('Still failing #%d: %s', $entry->id, $e->getMessage()) . PHP_EOL);
                    $stillFailing++;
                }
            }

            printf("%d resent, %d still failing.\n", $resent, $stillFailing);
            exit($stillFailing > 0 ? 1 : 0);
        }

        $id = null;
        foreach (array_slice($arguments, 1) as $argument) {
            if (is_string($argument) && !str_starts_with($argument, '--')) {
                $id = $argument;
                break;
            }
        }

        if ($id === null || preg_match('/^\d+$/', $id) !== 1) {
            fwrite(STDERR, 'Which mail? Try: orbit mail:resend 12, or orbit mail:resend --failed' . PHP_EOL);
            exit(1);
        }

        try {
            $entry = $mailer->resend((int) $id);
        } catch (InvalidArgumentException | MailFailed $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            exit(1);
        }

        printf(
            "Resent #%d to %s.\n",
            $entry->id,
            implode(', ', array_map(static fn ($address): string => $address->envelope(), $entry->to)),
        );
        exit(0);

    case 'cache:clear':
        CacheFactory::fromEnvironment(Environment::load($root . '/.env'), $root)->clear();
        echo 'Application cache cleared.' . PHP_EOL;
        exit(0);

    case 'storage:clear':
        // No reason to boot the application: the cache directory is a fixed
        // convention (storage/cache/views), not something configuration
        // changes. Safe to run at any time — TemplateEngine recompiles a
        // template the moment it finds no compiled file waiting for it, so
        // the very next render replaces whatever this deletes.
        $directory = $root . '/storage/cache/views';
        $removed = 0;

        foreach (glob($directory . '/*') ?: [] as $file) {
            if (is_file($file) && @unlink($file)) {
                $removed++;
            }
        }

        printf("Removed %d compiled template%s.\n", $removed, $removed === 1 ? '' : 's');
        exit(0);

    case 'sessions:gc':
        // No reason to boot the application: the session directory is a fixed
        // convention (storage/sessions), not something configuration changes,
        // and garbage collection is pure filesystem work.
        $removed = (new FileSessionStore($root . '/storage/sessions'))->collectGarbage();

        printf("Removed %d expired session%s.\n", $removed, $removed === 1 ? '' : 's');
        exit(0);

    case 'routes':
        /** @var Application $app */
        $app = require $bootstrap;

        $rows = [];
        foreach ($app->router()->routes() as $route) {
            $rows[] = [$route->method->value, $route->pattern, $route->name ?? ''];
        }

        usort($rows, static fn (array $a, array $b): int => [$a[1], $a[0]] <=> [$b[1], $b[0]]);

        foreach ($rows as [$method, $pattern, $name]) {
            printf("%-7s %-40s %s\n", $method, $pattern, $name);
        }

        exit(0);

    case 'help':
        echo $usage;
        exit(0);

    default:
        fwrite(STDERR, sprintf('Unknown command "%s".', $command) . PHP_EOL . PHP_EOL . $usage);
        exit(1);
    }
} catch (CacheFailed $e) {
    fwrite(STDERR, 'Cache error: ' . $e->getMessage() . PHP_EOL);
    exit(1);
} catch (InvalidEnvFile | MissingConfiguration | ConnectionFailed $e) {
    fwrite(STDERR, 'Configuration error: ' . $e->getMessage() . PHP_EOL);
    exit(1);
} catch (SeedFailed $e) {
    fwrite(STDERR, 'Seeding error: ' . $e->getMessage() . PHP_EOL);
    exit(1);
} catch (InvalidRoutePattern $e) {
    fwrite(STDERR, 'Routing error: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
