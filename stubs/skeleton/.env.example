# Copy to .env. The file is git-ignored; this example is not.
#
# Values already present in the real environment win over this file, so a
# secret injected by systemd, Docker or Kubernetes is never shadowed by a stale
# .env left on the server.

# Exposes exception detail in responses and recompiles templates every render.
# Never true in production.
APP_DEBUG=true

# Absolute, and used for link previews and generated absolute URLs.
APP_URL=http://localhost:8080

# 32 random bytes, base64-encoded. Generate with `orbit key:generate`.
# Required: encryption and signing refuse to start without it, and a blank
# value is exactly as unusable as an absent one.
APP_KEY=

# Keys retired by a rotation. Comma-separated, still able to read data written
# before the change, never used to write new.
#APP_PREVIOUS_KEYS=

# debug | info | warning | error
LOG_LEVEL=info

# sqlite | mysql | pgsql   ("postgres", "postgresql" and "mariadb" also work)
DB_DRIVER=sqlite

# sqlite: a file path, resolved against the project root. ":memory:" works too.
# mysql/pgsql: the database name, and required.
DB_DATABASE=storage/app.sqlite

# Ignored by sqlite. Port defaults to 3306 (mysql) or 5432 (pgsql).
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USERNAME=
#DB_PASSWORD=
#DB_CHARSET=utf8mb4
#DB_SOCKET=/var/run/mysqld/mysqld.sock

# array | smtp
# "array" keeps messages in memory instead of sending them — the right default
# in development, and what tests use.
MAIL_DRIVER=array

#MAIL_HOST=smtp.example.test
# tls (STARTTLS, port 587) | ssl (implicit TLS, port 465) | none
#MAIL_ENCRYPTION=tls
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM_ADDRESS=no-reply@example.test
#MAIL_FROM_NAME=phporbit
#MAIL_TIMEOUT=10
# Sending credentials over an unencrypted connection is refused unless this is
# set: SMTP AUTH base64-encodes the password, which is not encryption.
#MAIL_ALLOW_INSECURE_AUTH=false

# Session cookie name and server-side lifetime, in seconds.
SESSION_LIFETIME=7200
SESSION_COOKIE=orbit_session

# Comma-separated. Only these addresses may set X-Forwarded-Proto; without the
# list it is ignored entirely, so nobody can claim their plaintext request was
# HTTPS and unlock Secure-only cookies.
TRUSTED_PROXIES=
