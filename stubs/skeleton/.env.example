# Copy to .env. The file is git-ignored; this example is not.
#
# Values already present in the real environment win over this file, so a
# secret injected by systemd, Docker or Kubernetes is never shadowed by a stale
# .env left on the server.

# Exposes exception detail in responses and recompiles templates every render.
# Never true in production.
APP_DEBUG=true

# Absolute, and used for link previews and generated absolute URLs.
APP_URL=http://localhost:8080

# 32 random bytes, base64-encoded. Generate with `orbit key:generate`.
# Required: encryption and signing refuse to start without it, and a blank
# value is exactly as unusable as an absent one.
APP_KEY=

# Keys retired by a rotation. Comma-separated, still able to read data written
# before the change, never used to write new.
#APP_PREVIOUS_KEYS=

# debug | info | warning | error
LOG_LEVEL=info
# JSON lines: stderr | stdout | file. stdout is intended for CLI/container hosts.
LOG_OUTPUT=stderr
LOG_PATH=storage/logs/app.log
LOG_SERVICE=phporbit
APP_ENV=production
# JWTs use a purpose-derived APP_KEY; rotate APP_KEY to invalidate JWT signatures.
# Defaults: APP_URL as issuer, phporbit-api as audience.
#API_JWT_ISSUER=https://app.example.test
API_JWT_AUDIENCE=phporbit-api

# sqlite | mysql | pgsql | sqlsrv (also accepts postgres, postgresql, mariadb,
# sqlserver, sql_server and mssql)
DB_DRIVER=sqlite

# sqlite: a file path, resolved against the project root. ":memory:" works too.
# mysql/pgsql/sqlsrv: the database name, and required.
DB_DATABASE=storage/app.sqlite

# Ignored by sqlite. DB_PORT defaults to 3306 (mysql), 5432 (pgsql) and
# 1433 (SQL Server).
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USERNAME=
#DB_PASSWORD=
# DB_CHARSET applies to mysql and pgsql. PDO_SQLSRV uses UTF-8 by default.
#DB_CHARSET=utf8mb4
#DB_SOCKET=/var/run/mysqld/mysqld.sock

# Application data cache: file (or storage) | redis | memcached.
# TTL is seconds; 0 never expires. File storage needs no server or extension.
CACHE_DRIVER=file
CACHE_TTL=300
#CACHE_PATH=storage/cache/data
# Defaults to a hash of the project root. Use one unique prefix across all
# deployed instances of this application sharing a remote cache.
#CACHE_PREFIX=my-app
# Redis defaults to 6379; Memcached to 11211. Both need their PHP extension.
#CACHE_HOST=127.0.0.1
#CACHE_PORT=6379
#CACHE_TIMEOUT=2
# Redis only.
#CACHE_DATABASE=0
#CACHE_USERNAME=
#CACHE_PASSWORD=

# array | smtp
# "array" keeps messages in memory instead of sending them — the right default
# in development, and what tests use.
MAIL_DRIVER=array

# true stores messages as pending in mail_log instead of sending them directly.
# Deliver them later with `orbit mail:send-pending`.
MAIL_QUEUE=false

#MAIL_HOST=smtp.example.test
# tls (STARTTLS, port 587) | ssl (implicit TLS, port 465) | none
#MAIL_ENCRYPTION=tls
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM_ADDRESS=no-reply@example.test
#MAIL_FROM_NAME=phporbit
#MAIL_TIMEOUT=10
# Sending credentials over an unencrypted connection is refused unless this is
# set: SMTP AUTH base64-encodes the password, which is not encryption.
#MAIL_ALLOW_INSECURE_AUTH=false

# Session cookie name and server-side lifetime, in seconds.
SESSION_LIFETIME=7200
SESSION_COOKIE=orbit_session

# Demo authentication: exact APP_URL + /auth/google/callback or
# /auth/entra/callback must be a registered Web redirect URI. HTTPS except loopback.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=
# Explicit comma-separated tenant UUIDs; never common/organizations.
#ENTRA_TENANT_IDS=
# Reset/magic emails require MAIL_DRIVER=smtp; sent directly without mail audit.

# Comma-separated. Only these addresses may set X-Forwarded-Proto; without the
# list it is ignored entirely, so nobody can claim their plaintext request was
# HTTPS and unlock Secure-only cookies.
TRUSTED_PROXIES=
